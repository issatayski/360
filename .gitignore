# secrets — реальные креды БД/API правятся прямо в lib/config.php на хосте,
# но если заведёшь .env-подобные файлы — не коммить их
.env
.env*.local

# app runtime data — не коммитим загрузки агентов и локальную SQLite-базу
public_html/uploads/*
!public_html/uploads/.htaccess
!public_html/uploads/.gitkeep
public_html/data/

# harness / tooling — игнорируем всё в .claude, КРОМЕ версионируемых скиллов
.claude/*
!.claude/skills/
.venv/
__pycache__/

# misc
.DS_Store
*.log
