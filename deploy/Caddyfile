# Caddy терминирует HTTPS для сайта и проксирует на Apache/PHP.
# Авто-TLS Let's Encrypt (нужны открытые порты 80/443 и домен → IP VPS).
# reverse_proxy стримит — нет лимита размера тела и таймаута ответа, что важно
# для загрузки кадров и долгой склейки. Воркер наружу НЕ выставлен (внутренний).
{$SITE_DOMAIN} {
    encode gzip
    reverse_proxy php:80
}
