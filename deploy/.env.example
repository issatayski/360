# Скопируй в .env рядом с docker-compose.yml и заполни (Ctrl+O, Enter, Ctrl+X в nano).
SITE_DOMAIN=360.sifro.kz

# База (придумай пароли — латиница/цифры, без пробелов)
DB_NAME=tour360
DB_USER=tour
DB_PASS=ПРИДУМАЙ_ПАРОЛЬ_БД
DB_ROOT_PASS=ПРИДУМАЙ_ROOT_ПАРОЛЬ_БД

# Общий секрет воркера (просто длинная случайная строка)
WORKER_TOKEN=ПРИДУМАЙ_ДЛИННЫЙ_СЕКРЕТ

# Качество склейки (на VPS 4ГБ можно так; на 2ГБ поставь MAX_WIDTH=3072)
MAX_WIDTH=4096
STITCH_BLEND=multiband
