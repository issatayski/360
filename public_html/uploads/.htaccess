# Папка загрузок: отдаём только картинки, запрещаем исполнение скриптов.
Options -Indexes
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|pl|py|cgi|asp|aspx|sh|jsp)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>php_flag engine off</IfModule>
<IfModule mod_php7.c>php_flag engine off</IfModule>
<IfModule mod_php8.c>php_flag engine off</IfModule>
