# --- 360 Tour: корневой .htaccess ---
# ВНИМАНИЕ: без "Options -Indexes" и "DirectoryIndex" — некоторые shared-хостинги
# не разрешают эти директивы в .htaccess (AllowOverride) и отвечают 500.
# index.php и так является индексом по умолчанию. Оставлена только защита
# служебных файлов тем же синтаксисом, что и в lib/.htaccess (он хостом принят).

<FilesMatch "\.(sql|md|sqlite|log)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
